# TASK B4 - BIN PACKING USING FIRST FIT DECREASINGdef first_fit_decreasing(workloads, capacity):    # Sort workloads in descending order    sorted_workloads = sorted(workloads, reverse=True)    # Store servers and their allocated workloads    servers = []    # Count placement attempts    placement_attempts = 0    for workload in sorted_workloads:        placed = False        # Check existing servers        for server in servers:            placement_attempts += 1            if sum(server) + workload <= capacity:                server.append(workload)                placed = True                break        # Create a new server if required        if not placed:            servers.append([workload])    # Display output    print("\n========== BIN PACKING RESULT ==========")



